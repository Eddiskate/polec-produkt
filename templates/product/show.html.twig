{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} — {{ site_name }}{% endblock %}
{% block meta_description %}{{ product.summary }}{% endblock %}

{% block body %}
<span class="badge{% if product.ownProduct|default(false) %} badge-own{% endif %}">
    {% if product.ownProduct|default(false) %}
        Strona pod klucz
    {% else %}
        {{ product.categoryLabel|default(product.category) }}
    {% endif %}
</span>
<h1 class="page-title">{{ product.name }}</h1>
<p class="lede">{{ product.summary }}</p>

<div class="cta-row">
    {% if product.ownProduct|default(false) %}
        <a class="btn btn-accent" href="{{ product.affiliateUrl }}" target="_blank" rel="noopener">{{ product.ctaLabel }}</a>
    {% else %}
        <a class="btn btn-accent" href="{{ product.affiliateUrl }}" target="_blank" rel="sponsored noopener">{{ product.ctaLabel }}</a>
    {% endif %}
    <a class="btn btn-ghost" href="{{ path('app_products') }}">Wróć do listy</a>
</div>

<div class="pros-cons">
    <div>
        <h3>Plusy</h3>
        <ul>
            {% for item in product.pros|default([]) %}
                <li>{{ item }}</li>
            {% endfor %}
        </ul>
    </div>
    <div>
        <h3>Minusy</h3>
        <ul>
            {% for item in product.cons|default([]) %}
                <li>{{ item }}</li>
            {% endfor %}
        </ul>
    </div>
</div>

{% if not product.ownProduct|default(false) %}
    <section class="section">
        <h2>Wolisz nie ogarniać hostingu sam?</h2>
        <p class="section-lead">BlackPage to strona firmowa pod klucz — bez kupowania hostingu, paneli i wieczornych „czemu strona nie działa”.</p>
        <a class="btn btn-primary" href="{{ path('app_product_show', {slug: 'blackpage'}) }}">Sprawdź BlackPage</a>
    </section>
{% endif %}

{% if related is not empty %}
    <section class="section">
        <h2>Porównaj też</h2>
        <div class="product-list">
            {% for item in related %}
                <a class="product-row" href="{{ path('app_product_show', {slug: item.slug}) }}">
                    <div>
                        <h3>{{ item.name }}</h3>
                        <p>{{ item.summary }}</p>
                    </div>
                    <div class="meta-col">→</div>
                </a>
            {% endfor %}
        </div>
    </section>
{% endif %}
{% endblock %}
