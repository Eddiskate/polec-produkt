{% extends 'base.html.twig' %}

{% block title %}Zgłoś produkt — {{ site_name }}{% endblock %}

{% block body %}
<h1 class="page-title">Zgłoś produkt</h1>
<p class="lede">Chcesz, żebyśmy rozważyli Twój produkt w katalogu? Napisz — na start przyjmujemy zgłoszenia mailowo. Płatne listingi i formularz z weryfikacją dołączymy w kolejnej fazie.</p>
<div class="cta-row">
    <a class="btn btn-primary" href="mailto:{{ contact_email }}?subject=Zgłoszenie%20produktu%20—%20polec-produkt.pl">Napisz na {{ contact_email }}</a>
</div>
{% endblock %}
