{% extends 'base.html.twig' %}

{% block title %}{{ site_name }} — hosting i narzędzia bez zgadywania{% endblock %}
{% block meta_description %}Porównania hostingu i narzędzi dla firm. Wybierz szybciej — z plusami, minusami i konkretnym CTA.{% endblock %}

{% block body %}
<section class="hero">
    <div class="hero-copy">
        <h1>Hosting bez forumowych wojen</h1>
        <p>Porównujemy oferty dla małych firm — co działa, czego unikać i kiedy lepiej wziąć stronę pod klucz.</p>
        <div class="cta-row">
            <a class="btn btn-primary" href="{{ path('app_products') }}">Porównaj produkty</a>
            <a class="btn btn-ghost" href="{{ path('app_product_show', {slug: 'blackpage'}) }}">Chcę stronę pod klucz</a>
        </div>
    </div>
    <aside class="hero-panel" aria-label="Podgląd polecanych">
        <p class="hero-panel-label">Na skróty</p>
        <ul class="hero-stack">
            {% for product in featured|slice(0, 4) %}
                <li>
                    <a href="{{ path('app_product_show', {slug: product.slug}) }}">
                        <span class="hero-stack-name">{{ product.name }}</span>
                        <span class="hero-stack-tag{% if product.ownProduct|default(false) %} is-own{% endif %}">
                            {% if product.ownProduct|default(false) %}
                                Pod klucz
                            {% else %}
                                {{ product.categoryLabel|default(product.category) }}
                            {% endif %}
                        </span>
                    </a>
                </li>
            {% endfor %}
        </ul>
    </aside>
</section>

<section class="section">
    <h2>Na start warto zobaczyć</h2>
    <p class="section-lead">Sprawdzone hostingi oraz BlackPage — jeśli wolisz oddać stronę w ręce zespołu zamiast składać wszystko sam.</p>
    <div class="product-list">
        {% for product in featured %}
            <a class="product-row" href="{{ path('app_product_show', {slug: product.slug}) }}">
                <div>
                    <span class="badge{% if product.ownProduct|default(false) %} badge-own{% endif %}">
                        {% if product.ownProduct|default(false) %}
                            Strona pod klucz
                        {% else %}
                            {{ product.categoryLabel|default(product.category) }}
                        {% endif %}
                    </span>
                    <h3>{{ product.name }}</h3>
                    <p>{{ product.summary }}</p>
                </div>
                <div class="meta-col">Zobacz →</div>
            </a>
        {% endfor %}
    </div>
</section>

<section class="section">
    <h2>Poradniki</h2>
    {% if posts is empty %}
        <p class="empty-note">Wkrótce pierwsze artykuły: jak wybrać hosting, kiedy wystarczy kreator, a kiedy strona pod klucz.</p>
    {% else %}
        <ul class="post-list">
            {% for post in posts %}
                <li>
                    <a href="{{ path('app_blog_post', {slug: post.slug}) }}">{{ post.title|default(post.name|default('Wpis')) }}</a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
    <p style="margin-top:1.25rem"><a href="{{ path('app_blog_index') }}">Wszystkie wpisy →</a></p>
</section>
{% endblock %}
