{% extends 'base.html.twig' %}

{% block title %}{{ site_name }} — polecenia hostingu i narzędzi{% endblock %}

{% block body %}
<section class="hero">
    <h1>{{ site_name }}</h1>
    <p>Szczere polecenia hostingu, narzędzi dla firm i stron pod klucz. Porównujemy opcje — Ty wybierasz. Linki partnerskie oznaczamy jawnie.</p>
    <div class="cta-row">
        <a class="btn btn-primary" href="{{ path('app_products') }}">Zobacz produkty</a>
        <a class="btn btn-ghost" href="{{ path('app_product_show', {slug: 'blackpage'}) }}">Wolisz stronę pod klucz?</a>
    </div>
</section>

<section class="section">
    <h2>Wyróżnione</h2>
    <p class="section-lead">Hostingi z programami partnerskimi oraz BlackPage — nasza strona firmowa pod klucz.</p>
    <div class="product-list">
        {% for product in featured %}
            <a class="product-row" href="{{ path('app_product_show', {slug: product.slug}) }}">
                <div>
                    <span class="badge{% if product.ownProduct|default(false) %} badge-own{% endif %}">
                        {{ product.categoryLabel|default(product.category) }}{% if product.ownProduct|default(false) %} · nasz produkt{% endif %}
                    </span>
                    <h3>{{ product.name }}</h3>
                    <p>{{ product.summary }}</p>
                </div>
                <div class="meta-col">Szczegóły →</div>
            </a>
        {% endfor %}
    </div>
</section>

<section class="section">
    <h2>Z bloga</h2>
    {% if posts is empty %}
        <p class="empty-note">Wpisy pojawią się po podłączeniu API bloga (web-portal).</p>
    {% else %}
        <ul class="post-list">
            {% for post in posts %}
                <li>
                    <a href="{{ path('app_blog_post', {slug: post.slug}) }}">{{ post.title|default(post.name|default('Wpis')) }}</a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
    <p style="margin-top:1.25rem"><a href="{{ path('app_blog_index') }}">Wszystkie wpisy →</a></p>
</section>
{% endblock %}
