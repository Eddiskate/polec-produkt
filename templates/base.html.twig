<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ site_name }}{% endblock %}</title>
    <meta name="description" content="{% block meta_description %}Porównania hostingu i narzędzi dla firm — wybierz szybciej, bez marketingowego szumu.{% endblock %}">
    <link rel="canonical" href="{% block canonical %}{{ site_url }}{{ app.request.pathInfo }}{% endblock %}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Sora:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/site.css?v=5">
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='10' fill='%230B1220'/%3E%3Ccircle cx='16' cy='16' r='7' fill='%230D9F6E'/%3E%3C/svg%3E">
    {% block head %}{% endblock %}
</head>
<body>
    <div class="page-bg" aria-hidden="true"></div>
    <header class="site-header">
        <a class="brand" href="{{ path('app_home') }}">{{ site_name }}</a>
        <nav class="nav" aria-label="Główne">
            <a href="{{ path('app_products') }}">Produkty</a>
            <a href="{{ path('app_blog_index') }}">Blog</a>
            <a href="{{ path('app_about') }}">O nas</a>
            <a class="nav-cta" href="{{ path('app_submit_product') }}">Zgłoś produkt</a>
        </nav>
    </header>

    <main>
        {% block body %}{% endblock %}
    </main>

    <footer class="site-footer">
        <p class="disclosure">Część linków na stronie to linki partnerskie. Jeśli coś kupisz przez taki link, możemy otrzymać prowizję — Ty nie dopłacasz. BlackPage to usługa naszego zespołu.</p>
        <div class="footer-row">
            <span>&copy; {{ "now"|date("Y") }} {{ site_name }}</span>
            <a href="mailto:{{ contact_email }}">{{ contact_email }}</a>
        </div>
    </footer>
</body>
</html>
