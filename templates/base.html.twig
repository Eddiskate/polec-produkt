<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ site_name }}{% endblock %}</title>
    <meta name="description" content="{% block meta_description %}Prawdziwe polecenia produktów i usług — hosting, narzędzia dla firm i więcej. Linki partnerskie oznaczamy jawnie.{% endblock %}">
    <link rel="canonical" href="{% block canonical %}{{ site_url }}{{ app.request.pathInfo }}{% endblock %}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/site.css">
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%231A2E28'/%3E%3Ctext x='16' y='22' text-anchor='middle' font-size='16' fill='%23E8C547' font-family='Georgia,serif'%3EP%3C/text%3E%3C/svg%3E">
    {% block head %}{% endblock %}
</head>
<body>
    <div class="page-bg" aria-hidden="true"></div>
    <header class="site-header">
        <a class="brand" href="{{ path('app_home') }}">{{ site_name }}</a>
        <nav class="nav" aria-label="Główne">
            <a href="{{ path('app_products') }}">Produkty</a>
            <a href="{{ path('app_blog_index') }}">Blog</a>
            <a href="{{ path('app_about') }}">O nas</a>
            <a class="nav-cta" href="{{ path('app_submit_product') }}">Zgłoś produkt</a>
        </nav>
    </header>

    <main>
        {% block body %}{% endblock %}
    </main>

    <footer class="site-footer">
        <p class="disclosure">Niektóre linki to linki partnerskie (afiliacyjne). Jeśli kupisz przez nie produkt, możemy otrzymać prowizję — bez dodatkowych kosztów dla Ciebie. BlackPage to nasz własny produkt.</p>
        <div class="footer-row">
            <span>&copy; {{ "now"|date("Y") }} {{ site_name }}</span>
            <a href="mailto:{{ contact_email }}">{{ contact_email }}</a>
        </div>
    </footer>
</body>
</html>
